{
  "info": {
    "name": "USDA SNAP Retailer Location Data API",
    "description": "Anonymous, read-only Esri ArcGIS Feature Service published by USDA FNA (formerly FNS) for currently authorized SNAP retailer locations nationwide. No API key required. Base URL: https://services1.arcgis.com/RLQu0rK7h4kbsBq5/arcgis/rest/services/snap_retailer_location_data/FeatureServer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://services1.arcgis.com/RLQu0rK7h4kbsBq5/arcgis/rest/services/snap_retailer_location_data/FeatureServer", "type": "string" }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Get feature service metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}?f=json", "host": ["{{baseUrl}}"], "query": [{ "key": "f", "value": "json" }] },
            "description": "Returns service-level metadata, including the single published layer (id 0, snap_retailer_location_data)."
          }
        },
        {
          "name": "Get layer metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/0?f=json", "host": ["{{baseUrl}}"], "path": ["0"], "query": [{ "key": "f", "value": "json" }] },
            "description": "Returns field definitions, geometry type, capabilities (Query only), and maxRecordCount (1000) for the SNAP retailer location layer."
          }
        }
      ]
    },
    {
      "name": "Retailers",
      "item": [
        {
          "name": "Get nationwide retailer count",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/0/query?where=1%3D1&returnCountOnly=true&f=json",
              "host": ["{{baseUrl}}"],
              "path": ["0", "query"],
              "query": [
                { "key": "where", "value": "1=1" },
                { "key": "returnCountOnly", "value": "true" },
                { "key": "f", "value": "json" }
              ]
            },
            "description": "Returns the total count of currently authorized SNAP retailer records (254,048 confirmed live on the review date)."
          }
        },
        {
          "name": "Query retailers by state",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/0/query?where=State%3D%27DC%27&outFields=Store_Name,Store_Street_Address,City,State,Zip_Code,Store_Type&resultRecordCount=10&f=json",
              "host": ["{{baseUrl}}"],
              "path": ["0", "query"],
              "query": [
                { "key": "where", "value": "State='DC'" },
                { "key": "outFields", "value": "Store_Name,Store_Street_Address,City,State,Zip_Code,Store_Type" },
                { "key": "resultRecordCount", "value": "10" },
                { "key": "f", "value": "json" }
              ]
            },
            "description": "Queries authorized SNAP retailers in a given state (District of Columbia in this example)."
          }
        },
        {
          "name": "Query retailers by store type",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/0/query?where=Store_Type%3D%27Supermarket%27&outFields=Store_Name,City,State,Store_Type&resultRecordCount=10&f=json",
              "host": ["{{baseUrl}}"],
              "path": ["0", "query"],
              "query": [
                { "key": "where", "value": "Store_Type='Supermarket'" },
                { "key": "outFields", "value": "Store_Name,City,State,Store_Type" },
                { "key": "resultRecordCount", "value": "10" },
                { "key": "f", "value": "json" }
              ]
            },
            "description": "Queries authorized SNAP retailers by store type, e.g. Convenience Store, Grocery Store, Supermarket, Super Store, Specialty Store, Farmers and Markets, Restaurant Meals Program, Other."
          }
        },
        {
          "name": "Paginate through all retailers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/0/query?where=1%3D1&outFields=*&resultOffset=0&resultRecordCount=1000&f=json",
              "host": ["{{baseUrl}}"],
              "path": ["0", "query"],
              "query": [
                { "key": "where", "value": "1=1" },
                { "key": "outFields", "value": "*" },
                { "key": "resultOffset", "value": "0" },
                { "key": "resultRecordCount", "value": "1000" },
                { "key": "f", "value": "json" }
              ]
            },
            "description": "Walks the full ~254,048-record nationwide dataset using resultOffset/resultRecordCount pagination (maxRecordCount is 1000 per page)."
          }
        },
        {
          "name": "Query retailers within a radius of a point",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/0/query?geometry=-77.0369%2C38.9072&geometryType=esriGeometryPoint&inSR=4326&distance=5&units=esriSRUnit_StatuteMile&spatialRel=esriSpatialRelIntersects&outFields=Store_Name,Store_Street_Address,City,State&f=json",
              "host": ["{{baseUrl}}"],
              "path": ["0", "query"],
              "query": [
                { "key": "geometry", "value": "-77.0369,38.9072" },
                { "key": "geometryType", "value": "esriGeometryPoint" },
                { "key": "inSR", "value": "4326" },
                { "key": "distance", "value": "5" },
                { "key": "units", "value": "esriSRUnit_StatuteMile" },
                { "key": "spatialRel", "value": "esriSpatialRelIntersects" },
                { "key": "outFields", "value": "Store_Name,Store_Street_Address,City,State" },
                { "key": "f", "value": "json" }
              ]
            },
            "description": "Locates authorized SNAP retailers within a radius of a point (Washington, DC coordinates in this example) - the core 'find retailers near me' pattern behind the public locator tool."
          }
        }
      ]
    }
  ]
}
